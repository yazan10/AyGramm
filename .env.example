# ==============================================================================
# AyGram Environment Variables (.env.example)
# إعدادات متغيرات البيئة لمنصة AyGram عند الرفع على Vercel و Supabase
# ==============================================================================

# Supabase Database & Auth (قاعدة بيانات سوبابيس والمصادقة)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Vercel Serverless API Base (المسار التلقائي للـ Serverless Functions)
VITE_API_BASE_URL=
VITE_USE_REMOTE_STORAGE=
